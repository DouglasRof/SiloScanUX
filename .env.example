# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API no painel do Supabase). Nunca commite .env.local — a chave
# anon é pública por natureza (protegida por Row Level Security), mas mesmo assim o
# arquivo real fica de fora do git.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Opcional — sem essa variável, o monitoramento de erro (Sentry) fica desligado e o
# app funciona normalmente. Crie um projeto gratuito em https://sentry.io e cole o DSN.
VITE_SENTRY_DSN=
